{
  "name": "cross-ui-kit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "跨端统一 UI/交互模板库：Web / PC(Tauri) / 小程序(Taro) / 原生App(Expo+Tamagui)，一套标准、三栈实现、AI 可直接取用",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "pack:portable": "node scripts/pack-portable.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens:build": "pnpm --filter @kit/tokens run build",
    "tokens:watch": "pnpm --filter @kit/tokens run watch",
    "registry:validate": "node scripts/validate-registry.mjs",
    "graduate": "node scripts/graduate.mjs",
    "graduate:check": "node scripts/graduate.mjs --stack web --check",
    "regress": "node scripts/graduate.mjs --regress",
    "quality:stable": "node scripts/verify-stable.mjs",
    "quality:native": "node scripts/quality-native.mjs",
    "test:scripts": "vitest run",
    "quality": "pnpm run registry:validate && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:scripts"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "style-dictionary": "^4.3.0",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,css,scss}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix"
    ]
  }
}
