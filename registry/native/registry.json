{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "@kit/native",
  "stack": "native",
  "description": "cross-ui-kit 原生组件（Expo + Tamagui 封装），用于 iOS/Android 原生 App",
  "items": [
    {
      "name": "button",
      "type": "registry:component",
      "title": "按钮 Button",
      "description": "原生按钮，Tamagui Button 的统一封装；触控热区不小于 44px；loading 防重复提交",
      "canonical": "Button",
      "status": "beta",
      "stack": "native",
      "dependencies": ["tamagui", "react-native"],
      "registryDependencies": [],
      "files": [
        { "path": "packages/ui-native/src/Button/Button.tsx", "type": "registry:component" },
        { "path": "packages/ui-native/src/Button/Button.types.ts", "type": "registry:ui" },
        { "path": "packages/ui-native/src/Button/index.ts", "type": "registry:ui" }
      ],
      "props": [
        {
          "name": "variant",
          "type": "'primary'|'secondary'|'ghost'|'danger'|'link'",
          "default": "'primary'",
          "required": false,
          "desc": "视觉层级，与 web/mini 语义一致"
        },
        {
          "name": "size",
          "type": "'sm'|'md'|'lg'",
          "default": "'md'",
          "required": false,
          "desc": "尺寸；最小热区 44px"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "禁用态"
        },
        {
          "name": "loading",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "加载中，自动禁用并显示 ActivityIndicator"
        },
        {
          "name": "block",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "是否撑满父容器宽度"
        },
        {
          "name": "icon",
          "type": "ReactNode",
          "required": false,
          "desc": "前置图标，loading 时被替换"
        },
        {
          "name": "accessibilityLabel",
          "type": "string",
          "required": false,
          "desc": "无障碍标签，图标按钮必填"
        }
      ],
      "events": [
        { "name": "onPress", "type": "(e) => void", "desc": "按压点击（web 对应 onClick）" }
      ],
      "slots": ["children", "icon"],
      "tokens": [
        "color-primary-default",
        "color-primary-active",
        "color-primary-text",
        "color-danger-default",
        "color-danger-hover",
        "color-text-link",
        "color-bg-card",
        "color-bg-hover",
        "color-border-default",
        "radius-md",
        "control-height-sm",
        "control-height-md",
        "control-height-lg",
        "touch-min",
        "font-size-body-sm",
        "font-size-body-md",
        "font-size-body-lg"
      ],
      "states": ["default", "pressed", "disabled", "loading"],
      "a11y": "必须设置 accessibilityLabel 与 accessibilityRole='button'",
      "usage": {
        "do": ["提交绑定 loading", "补齐 accessibility* 属性", "样式只引用 Tamagui token"],
        "dont": ["写裸样式对象颜色", "绕过封装直接拼业务样式"]
      },
      "docs": "packages/ui-native/src/Button/README.md",
      "examples": ["packages/ui-native/src/Button/__examples__/Variants.tsx"]
    },
    {
      "name": "input",
      "type": "registry:component",
      "title": "输入框 Input",
      "description": "Tamagui Input 封装：尺寸/错误态/图标槽/禁用只读；type 映射 keyboardType/secureTextEntry，onChange 接 onChangeText",
      "canonical": "Input",
      "status": "beta",
      "stack": "native",
      "dependencies": ["tamagui", "react-native"],
      "registryDependencies": [],
      "files": [
        { "path": "packages/ui-native/src/Input/Input.tsx", "type": "registry:component" },
        { "path": "packages/ui-native/src/Input/Input.types.ts", "type": "registry:ui" },
        { "path": "packages/ui-native/src/Input/index.ts", "type": "registry:ui" }
      ],
      "props": [
        { "name": "value", "type": "string", "required": false, "desc": "受控值" },
        { "name": "defaultValue", "type": "string", "required": false, "desc": "非受控初值" },
        {
          "name": "type",
          "type": "'text'|'password'|'number'|'tel'|'email'|'search'",
          "default": "'text'",
          "required": false,
          "desc": "password 映射 secureTextEntry；number/tel/email 映射 keyboardType"
        },
        {
          "name": "size",
          "type": "'sm'|'md'|'lg'",
          "default": "'md'",
          "required": false,
          "desc": "高度与字号 token"
        },
        {
          "name": "error",
          "type": "boolean|string",
          "default": "false",
          "required": false,
          "desc": "danger 边框 + 错误文本（accessibilityHint）"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "editable=false 并置灰"
        },
        {
          "name": "readOnly",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "editable=false 不置灰"
        },
        { "name": "prefixIcon", "type": "ReactNode", "required": false, "desc": "前置图标槽" },
        { "name": "suffixIcon", "type": "ReactNode", "required": false, "desc": "后置图标槽" },
        { "name": "maxLength", "type": "number", "required": false, "desc": "最大长度" },
        {
          "name": "accessibilityLabel",
          "type": "string",
          "required": false,
          "desc": "无障碍标签，必填语义"
        }
      ],
      "events": [
        {
          "name": "onChange",
          "type": "(value: string) => void",
          "desc": "值变化（内部接 RN onChangeText）"
        }
      ],
      "slots": ["prefixIcon", "suffixIcon"],
      "tokens": [
        "color-bg-card",
        "color-bg-hover",
        "color-border-default",
        "color-border-danger",
        "color-text-primary",
        "color-text-tertiary",
        "color-text-danger",
        "radius-md",
        "control-height-sm",
        "control-height-md",
        "control-height-lg",
        "font-size-body-sm",
        "font-size-body-md",
        "font-size-body-lg"
      ],
      "states": ["default", "focus", "error", "disabled", "readonly"],
      "a11y": "必须传 accessibilityLabel；错误经 accessibilityHint 关联，错误文本 accessibilityRole=alert",
      "usage": {
        "do": ["样式只引用 Tamagui token", "onChange 用值回调", "补齐 accessibilityLabel"],
        "dont": ["写裸样式对象颜色", "直接把 RN keyboardType 暴露给业务"]
      },
      "docs": "packages/ui-native/src/Input/README.md",
      "examples": ["packages/ui-native/src/Input/__examples__/States.tsx"]
    },
    {
      "name": "checkbox",
      "type": "registry:component",
      "title": "复选框 Checkbox",
      "description": "Tamagui Checkbox 封装，选中底色由 Indicator 承担，支持选中/半选/禁用/错误/label，onChange 归一为 boolean",
      "canonical": "Checkbox",
      "status": "beta",
      "stack": "native",
      "dependencies": ["tamagui", "react-native"],
      "registryDependencies": [],
      "files": [
        { "path": "packages/ui-native/src/Checkbox/Checkbox.tsx", "type": "registry:component" },
        { "path": "packages/ui-native/src/Checkbox/Checkbox.types.ts", "type": "registry:ui" },
        { "path": "packages/ui-native/src/Checkbox/index.ts", "type": "registry:ui" }
      ],
      "props": [
        { "name": "checked", "type": "boolean", "required": false, "desc": "受控选中态" },
        {
          "name": "defaultChecked",
          "type": "boolean",
          "required": false,
          "desc": "非受控初值（文字点击切换仅受控可用）"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "禁用"
        },
        {
          "name": "indeterminate",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "半选"
        },
        { "name": "label", "type": "ReactNode", "required": false, "desc": "文本" },
        {
          "name": "error",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "未选框红边"
        },
        {
          "name": "accessibilityLabel",
          "type": "string",
          "required": false,
          "desc": "字符串 label 自动取用"
        }
      ],
      "events": [
        {
          "name": "onChange",
          "type": "(checked: boolean) => void",
          "desc": "选中态变化（onCheckedChange 归一）"
        }
      ],
      "slots": ["label"],
      "tokens": [
        "color-bg-card",
        "color-bg-hover",
        "color-border-default",
        "color-border-danger",
        "color-primary-default",
        "color-primary-text",
        "color-text-primary",
        "color-text-disabled",
        "radius-sm",
        "font-size-body-md"
      ],
      "states": ["unchecked", "checked", "indeterminate", "disabled", "error"],
      "a11y": "Tamagui Checkbox 自带 checkbox role 与选中态；字符串 label 自动作为 accessibilityLabel",
      "usage": {
        "do": ["选中底色交给 Indicator", "父子全选用 indeterminate", "样式只用 token"],
        "dont": ["引 SVG 图标库画勾（用字符）", "外泄 indeterminate 字符串"]
      },
      "docs": "packages/ui-native/src/Checkbox/README.md",
      "examples": ["packages/ui-native/src/Checkbox/__examples__/States.tsx"]
    }
  ]
}
