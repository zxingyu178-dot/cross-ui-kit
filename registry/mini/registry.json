      "name": "dialog",
      "type": "registry:component",
      "title": "对话框 Dialog",
      "description": "NutUI Popup(center, 受控) 做弹层底座 + 自建 token 卡片，用于确认/二次决策/表单；纯受控 open/onOpenChange，遮罩可配置，默认取消/确定等宽底部按钮",
      "canonical": "Dialog",
      "status": "beta",
      "stack": "mini",
      "dependencies": ["@nutui/nutui-react-taro", "@tarojs/components"],
      "registryDependencies": [],
      "files": [
        { "path": "packages/ui-mini/src/Dialog/Dialog.tsx", "type": "registry:component" },
        { "path": "packages/ui-mini/src/Dialog/Dialog.types.ts", "type": "registry:ui" },
        { "path": "packages/ui-mini/src/Dialog/Dialog.scss", "type": "registry:ui" },
        { "path": "packages/ui-mini/src/Dialog/index.ts", "type": "registry:ui" }
      ],
      "props": [
        { "name": "open", "type": "boolean", "required": true, "desc": "受控可见" },
        {
          "name": "onOpenChange",
          "type": "(open:boolean)=>void",
          "required": false,
          "desc": "关闭请求（遮罩/关闭钮/取消/确认统一以 false 回调）"
        },
        {
          "name": "title",
          "type": "ReactNode",
          "required": false,
          "desc": "标题（建议字符串或 Text 节点）"
        },
        {
          "name": "description",
          "type": "ReactNode",
          "required": false,
          "desc": "描述文本（无 children 时作为正文）"
        },
        {
          "name": "children",
          "type": "ReactNode",
          "required": false,
          "desc": "自定义正文，优先于 description"
        },
        {
          "name": "footer",
          "type": "ReactNode",
          "required": false,
          "desc": "自定义底部；不传则用默认取消/确定"
        },
        {
          "name": "showCancel",
          "type": "boolean",
          "default": "true",
          "required": false,
          "desc": "是否显示取消按钮"
        },
        {
          "name": "confirmText",
          "type": "string",
          "default": "'确定'",
          "required": false,
          "desc": "确定按钮文案"
        },
        {
          "name": "cancelText",
          "type": "string",
          "default": "'取消'",
          "required": false,
          "desc": "取消按钮文案"
        },
        {
          "name": "confirmLoading",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "确定按钮 loading（异步提交防重复）"
        },
        {
          "name": "closeOnOverlayClick",
          "type": "boolean",
          "default": "true",
          "required": false,
          "desc": "点遮罩是否请求关闭（false 时 onOverlayClick 返回 false 拦截）"
        }
      ],
      "events": [
        { "name": "onOpenChange", "type": "(open: boolean) => void", "desc": "开关请求" },
        {
          "name": "onConfirm",
          "type": "() => void | false",
          "desc": "点击确定；返回 false 阻止自动关闭（异步提交场景）"
        },
        { "name": "onCancel", "type": "() => void", "desc": "点击取消/关闭（随后请求关闭）" }
      ],
      "slots": ["title", "description", "children", "footer"],
      "tokens": [
        "color-bg-card",
        "color-border-default",
        "color-text-primary",
        "color-text-tertiary",
        "radius-lg",
        "shadow-popover",
        "font-size-title-sm",
        "font-size-body-md",
        "font-weight-medium",
        "icon-size-md",
        "touch-min",
        "spacing-3",
        "spacing-4"
      ],
      "states": ["closed", "open", "confirm-loading", "persistent"],
      "a11y": "Popup 提供遮罩与焦点语义；关闭钮带 aria-label 且热区为 touch-min；标题作为无障碍名称",
      "usage": {
        "do": [
          "受控 open/onOpenChange，异步提交用 confirmLoading",
          "卡片视觉只用 var(--kit-*)，弹层行为交给 NutUI Popup",
          "底部按钮复用 registry Button（小端 block 等宽）"
        ],
        "dont": [
          "用命令式 NutUI Dialog.open(selector)",
          "硬编码遮罩色/rpx",
          "在弹窗内写业务请求（下沉 core）"
        ]
      },
