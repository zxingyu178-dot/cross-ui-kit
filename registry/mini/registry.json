{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "@kit/mini",
  "stack": "mini",
  "description": "cross-ui-kit 小端组件（Taro 4 + NutUI-React 封装），用于微信/支付宝/字节小程序与移动 H5",
  "items": [
    {
      "name": "button",
      "type": "registry:component",
      "title": "按钮 Button",
      "description": "小端按钮，NutUI Button 的统一封装；触控热区不小于 44px；loading 防重复提交",
      "canonical": "Button",
      "status": "beta",
      "stack": "mini",
      "dependencies": ["@nutui/nutui-react-taro", "@tarojs/components", "@tarojs/taro"],
      "registryDependencies": [],
      "files": [
        { "path": "packages/ui-mini/src/Button/Button.tsx", "type": "registry:component" },
        { "path": "packages/ui-mini/src/Button/Button.types.ts", "type": "registry:ui" },
        { "path": "packages/ui-mini/src/Button/Button.scss", "type": "registry:ui" },
        { "path": "packages/ui-mini/src/Button/index.ts", "type": "registry:ui" }
      ],
      "props": [
        {
          "name": "variant",
          "type": "'primary'|'secondary'|'ghost'|'danger'|'link'",
          "default": "'primary'",
          "required": false,
          "desc": "视觉层级，与 web/native 语义一致"
        },
        {
          "name": "size",
          "type": "'sm'|'md'|'lg'",
          "default": "'md'",
          "required": false,
          "desc": "尺寸；最小热区 44px（touch-min）"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "禁用态"
        },
        {
          "name": "loading",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "加载中，自动禁用防重复提交"
        },
        {
          "name": "block",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "是否撑满父容器宽度"
        }
      ],
      "events": [
        {
          "name": "onPress",
          "type": "(e) => void",
          "desc": "点击（web 对应 onClick，封装层统一业务语义事件）"
        }
      ],
      "slots": ["children", "icon"],
      "tokens": [
        "color-primary-default",
        "color-text-link",
        "radius-md",
        "touch-min",
        "font-weight-regular",
        "line-height-normal",
        "motion-duration-fast"
      ],
      "states": ["default", "pressed", "disabled", "loading"],
      "a11y": "提供可读标签；图标按钮必须传文字或 aria 标注",
      "usage": {
        "do": ["提交绑定 loading", "热区不小于 44px", "主题色走 NutUI CSS 变量覆盖（token 产物）"],
        "dont": ["直接使用 NutUI 原始 API 拼业务", "内联 rpx/颜色", "在组件内发请求"]
      },
      "docs": "packages/ui-mini/src/Button/README.md",
      "examples": ["packages/ui-mini/src/Button/__examples__/Variants.tsx"]
    },
    {
      "name": "input",
      "type": "registry:component",
      "title": "输入框 Input",
      "description": "NutUI Input 统一封装：尺寸/错误态/图标槽/禁用只读，onChange 值回调；错误态与图标槽由封装容器提供",
      "canonical": "Input",
      "status": "beta",
      "stack": "mini",
      "dependencies": ["@nutui/nutui-react-taro", "@tarojs/components", "@tarojs/taro"],
      "registryDependencies": [],
      "files": [
        { "path": "packages/ui-mini/src/Input/Input.tsx", "type": "registry:component" },
        { "path": "packages/ui-mini/src/Input/Input.types.ts", "type": "registry:ui" },
        { "path": "packages/ui-mini/src/Input/Input.scss", "type": "registry:ui" },
        { "path": "packages/ui-mini/src/Input/index.ts", "type": "registry:ui" }
      ],
      "props": [
        { "name": "value", "type": "string", "required": false, "desc": "受控值" },
        { "name": "defaultValue", "type": "string", "required": false, "desc": "非受控初值" },
        {
          "name": "type",
          "type": "'text'|'password'|'number'|'tel'|'email'|'search'",
          "default": "'text'",
          "required": false,
          "desc": "number 映射 digit 数字键盘；tel/email/search 降级 text"
        },
        {
          "name": "size",
          "type": "'sm'|'md'|'lg'",
          "default": "'md'",
          "required": false,
          "desc": "容器高度 token"
        },
        {
          "name": "error",
          "type": "boolean|string",
          "default": "false",
          "required": false,
          "desc": "红色边框 + 错误文案"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "禁用"
        },
        {
          "name": "readOnly",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "只读"
        },
        { "name": "prefixIcon", "type": "ReactNode", "required": false, "desc": "前置图标槽" },
        { "name": "suffixIcon", "type": "ReactNode", "required": false, "desc": "后置图标槽" },
        { "name": "maxLength", "type": "number", "required": false, "desc": "最大长度" }
      ],
      "events": [
        {
          "name": "onChange",
          "type": "(value: string) => void",
          "desc": "值变化（NutUI 已为值回调）"
        }
      ],
      "slots": ["prefixIcon", "suffixIcon"],
      "tokens": [
        "color-bg-card",
        "color-bg-hover",
        "color-border-default",
        "color-border-danger",
        "color-text-primary",
        "color-text-tertiary",
        "color-text-danger",
        "radius-md",
        "control-height-sm",
        "control-height-md",
        "control-height-lg",
        "spacing-1",
        "spacing-2",
        "spacing-3",
        "font-size-body-sm",
        "font-size-body-md"
      ],
      "states": ["default", "focus", "error", "disabled", "readonly"],
      "a11y": "错误文案语义化展示；输入项须有可见 label 或无障碍标签",
      "usage": {
        "do": ["用封装容器的 error 属性", "样式只引用 var(--kit-*)", "onChange 接收值字符串"],
        "dont": ["直接依赖 NutUI 私有 props 写业务", "硬编码颜色/rpx"]
      },
      "docs": "packages/ui-mini/src/Input/README.md",
      "examples": ["packages/ui-mini/src/Input/__examples__/States.tsx"]
    },
    {
      "name": "checkbox",
      "type": "registry:component",
      "title": "复选框 Checkbox",
      "description": "NutUI Checkbox 封装，自定义图标接管视觉（token 配色），支持选中/半选/禁用/错误/label，onChange 为 boolean 回调",
      "canonical": "Checkbox",
      "status": "beta",
      "stack": "mini",
      "dependencies": ["@nutui/nutui-react-taro", "@tarojs/components", "@tarojs/taro"],
      "registryDependencies": [],
      "files": [
        { "path": "packages/ui-mini/src/Checkbox/Checkbox.tsx", "type": "registry:component" },
        { "path": "packages/ui-mini/src/Checkbox/Checkbox.types.ts", "type": "registry:ui" },
        { "path": "packages/ui-mini/src/Checkbox/Checkbox.scss", "type": "registry:ui" },
        { "path": "packages/ui-mini/src/Checkbox/index.ts", "type": "registry:ui" }
      ],
      "props": [
        { "name": "checked", "type": "boolean", "required": false, "desc": "受控选中态" },
        { "name": "defaultChecked", "type": "boolean", "required": false, "desc": "非受控初值" },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "禁用"
        },
        {
          "name": "indeterminate",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "半选"
        },
        { "name": "label", "type": "ReactNode", "required": false, "desc": "文本" },
        {
          "name": "error",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "未选框红边"
        }
      ],
      "events": [
        {
          "name": "onChange",
          "type": "(checked: boolean) => void",
          "desc": "选中态变化（NutUI 已是 boolean 回调）"
        }
      ],
      "slots": ["label", "icon", "activeIcon", "indeterminateIcon"],
      "tokens": [
        "color-bg-card",
        "color-bg-hover",
        "color-border-default",
        "color-border-danger",
        "color-primary-default",
        "color-primary-text",
        "radius-sm",
        "icon-size-md",
        "font-size-caption"
      ],
      "states": ["unchecked", "checked", "indeterminate", "disabled", "error"],
      "a11y": "基于 Taro Checkbox 原生语义；表单项须有可见 label",
      "usage": {
        "do": ["用自定义图标保持 token 配色", "onChange 接收 boolean"],
        "dont": ["依赖 NutUI 默认主题色", "硬编码颜色/rpx"]
      },
      "docs": "packages/ui-mini/src/Checkbox/README.md",
      "examples": ["packages/ui-mini/src/Checkbox/__examples__/States.tsx"]
    },
    {
      "name": "select",
      "type": "registry:component",
      "title": "选择器 Select",
      "description": "Taro Picker(selector) 底部滚轮选择 + 自建 token 风格触发框，onChange 归一为 value 字符串",
      "canonical": "Select",
      "status": "beta",
      "stack": "mini",
      "dependencies": ["@tarojs/components", "@tarojs/taro"],
      "registryDependencies": [],
      "files": [
        { "path": "packages/ui-mini/src/Select/Select.tsx", "type": "registry:component" },
        { "path": "packages/ui-mini/src/Select/Select.types.ts", "type": "registry:ui" },
        { "path": "packages/ui-mini/src/Select/Select.scss", "type": "registry:ui" },
        { "path": "packages/ui-mini/src/Select/index.ts", "type": "registry:ui" }
      ],
      "props": [
        {
          "name": "options",
          "type": "{label;value;disabled?}[]",
          "required": true,
          "desc": "选项列表（label 用字符串）"
        },
        { "name": "value", "type": "string", "required": false, "desc": "受控值" },
        { "name": "defaultValue", "type": "string", "required": false, "desc": "非受控初值" },
        {
          "name": "placeholder",
          "type": "string",
          "default": "'请选择'",
          "required": false,
          "desc": "占位文本"
        },
        {
          "name": "size",
          "type": "'sm'|'md'|'lg'",
          "default": "'md'",
          "required": false,
          "desc": "触发框高度 token"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "禁用"
        },
        {
          "name": "error",
          "type": "boolean|string",
          "default": "false",
          "required": false,
          "desc": "红框 + 错误文案"
        }
      ],
      "events": [
        {
          "name": "onChange",
          "type": "(value: string) => void",
          "desc": "Picker 索引反查 value 后回调"
        }
      ],
      "slots": [],
      "tokens": [
        "color-bg-card",
        "color-bg-hover",
        "color-border-default",
        "color-border-danger",
        "color-text-primary",
        "color-text-tertiary",
        "color-text-danger",
        "radius-md",
        "control-height-sm",
        "control-height-md",
        "control-height-lg",
        "spacing-1",
        "spacing-2",
        "spacing-3",
        "font-size-body-sm",
        "font-size-body-md"
      ],
      "states": ["closed", "open", "selected", "disabled", "error"],
      "a11y": "基于系统 Picker 原生无障碍；触发项须有语义，错误文案语义化展示",
      "usage": {
        "do": [
          "label 传字符串",
          "禁用项尽量不下发（系统 Picker 不灰显）",
          "触发框样式只用 var(--kit-*)"
        ],
        "dont": ["把 Picker 索引当业务值", "硬编码颜色/rpx"]
      },
      "docs": "packages/ui-mini/src/Select/README.md",
      "examples": ["packages/ui-mini/src/Select/__examples__/States.tsx"]
    }
  ]
}
