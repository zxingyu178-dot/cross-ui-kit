{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "@kit/web",
  "stack": "web",
  "description": "cross-ui-kit 大端组件（React DOM + shadcn/ui + Tailwind），用于网页与 Tauri 桌面/移动",
  "items": [
    {
      "name": "button",
      "type": "registry:component",
      "title": "按钮 Button",
      "description": "触发即时操作；每个主视觉区域只允许一个 primary 按钮；loading 时自动禁用防重复提交",
      "canonical": "Button",
      "status": "beta",
      "stack": "web",
      "dependencies": ["@radix-ui/react-slot", "class-variance-authority", "@kit/core"],
      "registryDependencies": [],
      "files": [
        { "path": "packages/ui-web/src/Button/Button.tsx", "type": "registry:component" },
        { "path": "packages/ui-web/src/Button/Button.types.ts", "type": "registry:ui" },
        { "path": "packages/ui-web/src/Button/index.ts", "type": "registry:ui" }
      ],
      "props": [
        {
          "name": "variant",
          "type": "'primary'|'secondary'|'ghost'|'danger'|'link'",
          "default": "'primary'",
          "required": false,
          "desc": "视觉层级，主操作每区仅一个 primary"
        },
        {
          "name": "size",
          "type": "'sm'|'md'|'lg'",
          "default": "'md'",
          "required": false,
          "desc": "控件尺寸，高度取 controlHeight token"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "禁用态"
        },
        {
          "name": "loading",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "加载中，自动禁用并显示 Spinner"
        },
        {
          "name": "className",
          "type": "string",
          "default": "''",
          "required": false,
          "desc": "样式透传，经 cn() 合并"
        }
      ],
      "events": [
        {
          "name": "onClick",
          "type": "(e: React.MouseEvent<HTMLButtonElement>) => void",
          "desc": "点击"
        }
      ],
      "slots": ["children", "icon"],
      "tokens": [
        "color-primary-default",
        "color-primary-hover",
        "color-primary-active",
        "color-primary-disabled",
        "color-primary-text",
        "color-danger-default",
        "color-danger-hover",
        "color-text-link",
        "color-border-default",
        "color-border-focus",
        "color-bg-card",
        "color-bg-hover",
        "color-bg-active",
        "radius-md",
        "control-height-sm",
        "control-height-md",
        "control-height-lg",
        "icon-size-md",
        "motion-duration-fast"
      ],
      "states": ["default", "hover", "active", "disabled", "loading"],
      "a11y": "图标按钮必须提供 aria-label；loading 时暴露 aria-busy",
      "usage": {
        "do": [
          "每个主视觉区域仅一个 primary",
          "提交动作绑定 loading 防重复提交",
          "视觉值只用 token"
        ],
        "dont": ["用 danger 表达普通取消", "内联颜色或间距", "在按钮内写业务请求"]
      },
      "docs": "packages/ui-web/src/Button/README.md",
      "examples": [
        "packages/ui-web/src/Button/__examples__/Variants.tsx",
        "packages/ui-web/src/Button/__examples__/States.tsx"
      ]
    }
  ]
}
