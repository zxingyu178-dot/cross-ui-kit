{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "@kit/web",
  "stack": "web",
  "description": "cross-ui-kit 大端组件（React DOM + shadcn/ui + Tailwind），用于网页与 Tauri 桌面/移动",
  "items": [
    {
      "name": "button",
      "type": "registry:component",
      "title": "按钮 Button",
      "description": "触发即时操作；每个主视觉区域只允许一个 primary 按钮；loading 时自动禁用防重复提交",
      "canonical": "Button",
      "status": "beta",
      "stack": "web",
      "dependencies": ["@radix-ui/react-slot", "class-variance-authority", "@kit/core"],
      "registryDependencies": [],
      "files": [
        { "path": "packages/ui-web/src/Button/Button.tsx", "type": "registry:component" },
        { "path": "packages/ui-web/src/Button/Button.types.ts", "type": "registry:ui" },
        { "path": "packages/ui-web/src/Button/index.ts", "type": "registry:ui" }
      ],
      "props": [
        {
          "name": "variant",
          "type": "'primary'|'secondary'|'ghost'|'danger'|'link'",
          "default": "'primary'",
          "required": false,
          "desc": "视觉层级，主操作每区仅一个 primary"
        },
        {
          "name": "size",
          "type": "'sm'|'md'|'lg'",
          "default": "'md'",
          "required": false,
          "desc": "控件尺寸，高度取 controlHeight token"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "禁用态"
        },
        {
          "name": "loading",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "加载中，自动禁用并显示 Spinner"
        },
        {
          "name": "className",
          "type": "string",
          "default": "''",
          "required": false,
          "desc": "样式透传，经 cn() 合并"
        }
      ],
      "events": [
        {
          "name": "onClick",
          "type": "(e: React.MouseEvent<HTMLButtonElement>) => void",
          "desc": "点击"
        }
      ],
      "slots": ["children", "icon"],
      "tokens": [
        "color-primary-default",
        "color-primary-hover",
        "color-primary-active",
        "color-primary-disabled",
        "color-primary-text",
        "color-danger-default",
        "color-danger-hover",
        "color-text-link",
        "color-border-default",
        "color-border-focus",
        "color-bg-card",
        "color-bg-hover",
        "color-bg-active",
        "radius-md",
        "control-height-sm",
        "control-height-md",
        "control-height-lg",
        "icon-size-md",
        "motion-duration-fast"
      ],
      "states": ["default", "hover", "active", "disabled", "loading"],
      "a11y": "图标按钮必须提供 aria-label；loading 时暴露 aria-busy",
      "usage": {
        "do": [
          "每个主视觉区域仅一个 primary",
          "提交动作绑定 loading 防重复提交",
          "视觉值只用 token"
        ],
        "dont": ["用 danger 表达普通取消", "内联颜色或间距", "在按钮内写业务请求"]
      },
      "docs": "packages/ui-web/src/Button/README.md",
      "examples": [
        "packages/ui-web/src/Button/__examples__/Variants.tsx",
        "packages/ui-web/src/Button/__examples__/States.tsx"
      ]
    },
    {
      "name": "input",
      "type": "registry:component",
      "title": "输入框 Input",
      "description": "单行文本输入，支持尺寸/错误态/图标槽/禁用只读，onChange 统一为值回调",
      "canonical": "Input",
      "status": "beta",
      "stack": "web",
      "dependencies": ["class-variance-authority", "@kit/core"],
      "registryDependencies": [],
      "files": [
        { "path": "packages/ui-web/src/Input/Input.tsx", "type": "registry:component" },
        { "path": "packages/ui-web/src/Input/Input.types.ts", "type": "registry:ui" },
        { "path": "packages/ui-web/src/Input/index.ts", "type": "registry:ui" }
      ],
      "props": [
        { "name": "value", "type": "string", "required": false, "desc": "受控值" },
        { "name": "defaultValue", "type": "string", "required": false, "desc": "非受控初值" },
        {
          "name": "type",
          "type": "'text'|'password'|'number'|'tel'|'email'|'search'",
          "default": "'text'",
          "required": false,
          "desc": "输入类型"
        },
        {
          "name": "size",
          "type": "'sm'|'md'|'lg'",
          "default": "'md'",
          "required": false,
          "desc": "高度取 control-height token"
        },
        {
          "name": "error",
          "type": "boolean|string",
          "default": "false",
          "required": false,
          "desc": "true 仅红色高亮；字符串同时显示错误文案"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "禁用"
        },
        {
          "name": "readOnly",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "只读"
        },
        { "name": "prefixIcon", "type": "ReactNode", "required": false, "desc": "前置图标槽" },
        { "name": "suffixIcon", "type": "ReactNode", "required": false, "desc": "后置图标槽" },
        { "name": "maxLength", "type": "number", "required": false, "desc": "最大长度" }
      ],
      "events": [
        {
          "name": "onChange",
          "type": "(value: string) => void",
          "desc": "值变化（已归一为值回调）"
        }
      ],
      "slots": ["prefixIcon", "suffixIcon"],
      "tokens": [
        "color-bg-card",
        "color-bg-hover",
        "color-border-default",
        "color-border-focus",
        "color-border-danger",
        "color-text-primary",
        "color-text-tertiary",
        "color-text-disabled",
        "color-text-danger",
        "radius-md",
        "control-height-sm",
        "control-height-md",
        "control-height-lg",
        "icon-size-md"
      ],
      "states": ["default", "focus", "error", "disabled", "readonly"],
      "a11y": "错误时 aria-invalid 并以 aria-describedby 关联 role=alert 错误文案；须有 label 或 aria-label",
      "usage": {
        "do": ["受控配合 react-hook-form+zod", "错误用 error 属性统一展示", "图标槽只放装饰图标"],
        "dont": ["自行拼边框样式", "直接用原生 event 而非值回调", "硬编码颜色"]
      },
      "docs": "packages/ui-web/src/Input/README.md",
      "examples": ["packages/ui-web/src/Input/__examples__/States.tsx"]
    },
    {
      "name": "checkbox",
      "type": "registry:component",
      "title": "复选框 Checkbox",
      "description": "Radix Checkbox 封装，支持选中/半选/禁用/错误/label，onChange 统一为 boolean 值回调",
      "canonical": "Checkbox",
      "status": "beta",
      "stack": "web",
      "dependencies": ["@radix-ui/react-checkbox", "@kit/core"],
      "registryDependencies": [],
      "files": [
        { "path": "packages/ui-web/src/Checkbox/Checkbox.tsx", "type": "registry:component" },
        { "path": "packages/ui-web/src/Checkbox/Checkbox.types.ts", "type": "registry:ui" },
        { "path": "packages/ui-web/src/Checkbox/index.ts", "type": "registry:ui" }
      ],
      "props": [
        { "name": "checked", "type": "boolean", "required": false, "desc": "受控选中态" },
        { "name": "defaultChecked", "type": "boolean", "required": false, "desc": "非受控初值" },
        {
          "name": "disabled",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "禁用"
        },
        {
          "name": "indeterminate",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "半选（父级全选场景）"
        },
        {
          "name": "label",
          "type": "ReactNode",
          "required": false,
          "desc": "文本，传入后点文本可切换"
        },
        {
          "name": "error",
          "type": "boolean",
          "default": "false",
          "required": false,
          "desc": "错误态红框 + aria-invalid"
        }
      ],
      "events": [
        {
          "name": "onChange",
          "type": "(checked: boolean) => void",
          "desc": "选中态变化（值回调，indeterminate 已归一）"
        }
      ],
      "slots": ["label"],
      "tokens": [
        "color-bg-card",
        "color-bg-hover",
        "color-border-default",
        "color-border-focus",
        "color-border-danger",
        "color-primary-default",
        "color-primary-disabled",
        "color-primary-text",
        "color-text-primary",
        "color-text-disabled",
        "radius-sm",
        "icon-size-md"
      ],
      "states": ["unchecked", "checked", "indeterminate", "disabled", "error"],
      "a11y": "Radix 自带 role=checkbox 与 aria-checked（含 mixed）；错误补 aria-invalid；label 用 id 关联",
      "usage": {
        "do": ["父子全选用 indeterminate", "onChange 接收 boolean", "label 传文本获得可点区域"],
        "dont": ["外泄 Radix 的 indeterminate 字符串", "硬编码选中色"]
      },
      "docs": "packages/ui-web/src/Checkbox/README.md",
      "examples": ["packages/ui-web/src/Checkbox/__examples__/States.tsx"]
    }
  ]
}
