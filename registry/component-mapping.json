{
  "version": 1,
  "description": "三栈组件 canonical 语义映射表，唯一事实来源；新增组件先在此登记（docs/06-registry.md §3）",
  "components": [
    {
      "canonical": "Button",
      "category": "base",
      "sharedProps": {
        "variant": "primary|secondary|ghost|danger|link",
        "size": "sm|md|lg",
        "disabled": "boolean",
        "loading": "boolean",
        "block": "boolean",
        "icon": "ReactNode"
      },
      "eventMap": { "web": "onClick", "mini": "onPress", "native": "onPress" },
      "stacks": {
        "web": { "item": "@kit/web-button", "status": "beta" },
        "mini": { "item": "@kit/mini-button", "status": "beta" },
        "native": { "item": "@kit/native-button", "status": "beta" }
      }
    },
    {
      "canonical": "Input",
      "category": "form",
      "sharedProps": {
        "value": "string",
        "defaultValue": "string",
        "placeholder": "string",
        "type": "text|password|number|tel|email|search",
        "size": "sm|md|lg",
        "disabled": "boolean",
        "readOnly": "boolean",
        "error": "boolean|string",
        "maxLength": "number",
        "prefixIcon": "ReactNode",
        "suffixIcon": "ReactNode"
      },
      "eventMap": {
        "web": "onChange(value)",
        "mini": "onChange(value)",
        "native": "onChangeText->onChange(value)"
      },
      "stacks": {
        "web": { "item": "@kit/web-input", "status": "beta" },
        "mini": { "item": "@kit/mini-input", "status": "beta" },
        "native": { "item": "@kit/native-input", "status": "beta" }
      }
    },
    {
      "canonical": "Checkbox",
      "category": "form",
      "sharedProps": {
        "checked": "boolean",
        "defaultChecked": "boolean",
        "disabled": "boolean",
        "indeterminate": "boolean",
        "label": "ReactNode",
        "error": "boolean"
      },
      "eventMap": {
        "web": "onCheckedChange->onChange(boolean)",
        "mini": "onChange(boolean)",
        "native": "onCheckedChange->onChange(boolean)"
      },
      "stacks": {
        "web": { "item": "@kit/web-checkbox", "status": "beta" },
        "mini": { "item": "@kit/mini-checkbox", "status": "beta" },
        "native": { "item": "@kit/native-checkbox", "status": "beta" }
      }
    },
    {
      "canonical": "Select",
      "category": "form",
      "sharedProps": {
        "options": "{label: ReactNode; value: string; disabled?: boolean}[]",
        "value": "string",
        "defaultValue": "string",
        "placeholder": "string",
        "size": "sm|md|lg",
        "disabled": "boolean",
        "error": "boolean|string"
      },
      "eventMap": {
        "web": "onValueChange->onChange(value)",
        "mini": "Picker.onChange(index)->onChange(value)",
        "native": "Modal option press->onChange(value)"
      },
      "stacks": {
        "web": { "item": "@kit/web-select", "status": "beta" },
        "mini": { "item": "@kit/mini-select", "status": "beta" },
        "native": { "item": "@kit/native-select", "status": "beta" }
      }
    },
    {
      "canonical": "Dialog",
      "category": "overlay",
      "sharedProps": {
        "open": "boolean",
        "title": "ReactNode",
        "description": "ReactNode",
        "children": "ReactNode",
        "footer": "ReactNode",
        "showCancel": "boolean",
        "confirmText": "string",
        "cancelText": "string",
        "confirmLoading": "boolean",
        "closeOnOverlayClick": "boolean"
      },
      "eventMap": {
        "web": "onOpenChange(open) / onConfirm / onCancel（Esc 受 closeOnEsc 控制）",
        "mini": "Popup.onClose/onOverlayClick->onOpenChange(open) / onConfirm / onCancel",
        "native": "Modal.onRequestClose/遮罩 onPress->onOpenChange(open) / onConfirm / onCancel"
      },
      "stacks": {
        "web": { "item": "@kit/web-dialog", "status": "beta" },
        "mini": { "item": "@kit/mini-dialog", "status": "beta" },
        "native": { "item": "@kit/native-dialog", "status": "beta" }
      }
    },
    {
      "canonical": "Toast",
      "category": "overlay",
      "sharedProps": {
        "open": "boolean",
        "message": "ReactNode",
        "type": "info|success|warning|error|loading",
        "duration": "number",
        "position": "top|center|bottom"
      },
      "eventMap": {
        "web": "Radix duration/swipe->onOpenChange(open) / onClose",
        "mini": "NutUI duration/onClose->onOpenChange(open) / onClose",
        "native": "内部 setTimeout->onOpenChange(open) / onClose"
      },
      "stacks": {
        "web": { "item": "@kit/web-toast", "status": "beta" },
        "mini": { "item": "@kit/mini-toast", "status": "beta" },
        "native": { "item": "@kit/native-toast", "status": "beta" }
      }
    },
    {
      "canonical": "Switch",
      "category": "form",
      "sharedProps": {
        "checked": "boolean",
        "defaultChecked": "boolean",
        "disabled": "boolean",
        "loading": "boolean",
        "size": "sm|md",
        "label": "ReactNode"
      },
      "eventMap": {
        "web": "Radix onCheckedChange(boolean)",
        "mini": "NutUI onChange(boolean) -> onCheckedChange",
        "native": "Tamagui onCheckedChange(boolean)"
      },
      "stacks": {
        "web": { "item": "@kit/web-switch", "status": "beta" },
        "mini": { "item": "@kit/mini-switch", "status": "beta" },
        "native": { "item": "@kit/native-switch", "status": "beta" }
      }
    },
    {
      "canonical": "RadioGroup",
      "category": "form",
      "sharedProps": {
        "options": "RadioOption[] { value, label, disabled? }",
        "value": "string",
        "defaultValue": "string",
        "disabled": "boolean",
        "direction": "vertical|horizontal",
        "size": "sm|md"
      },
      "eventMap": {
        "web": "Radix onValueChange(string)",
        "mini": "NutUI onChange(SimpleValue) -> String -> onValueChange",
        "native": "Tamagui onValueChange(string)"
      },
      "stacks": {
        "web": { "item": "@kit/web-radio-group", "status": "beta" },
        "mini": { "item": "@kit/mini-radio-group", "status": "beta" },
        "native": { "item": "@kit/native-radio-group", "status": "beta" }
      }
    },
    {
      "canonical": "Badge",
      "category": "data-display",
      "sharedProps": {
        "children": "ReactNode",
        "variant": "primary|success|warning|danger|info|neutral",
        "tone": "soft|solid|outline",
        "size": "sm|md"
      },
      "eventMap": {
        "web": "onClick()",
        "mini": "onClick()",
        "native": "onPress()"
      },
      "stacks": {
        "web": { "item": "@kit/web-badge", "status": "beta" },
        "mini": { "item": "@kit/mini-badge", "status": "beta" },
        "native": { "item": "@kit/native-badge", "status": "beta" }
      }
    },
    {
      "canonical": "Tabs",
      "category": "navigation",
      "sharedProps": {
        "items": "TabItem[] { value, label, disabled?, content? }",
        "value": "string",
        "defaultValue": "string",
        "size": "sm|md"
      },
      "eventMap": {
        "web": "Radix onValueChange(string)",
        "mini": "NutUI onChange(SimpleValue) -> String -> onValueChange",
        "native": "Tamagui onValueChange(string)"
      },
      "stacks": {
        "web": { "item": "@kit/web-tabs", "status": "beta" },
        "mini": { "item": "@kit/mini-tabs", "status": "beta" },
        "native": { "item": "@kit/native-tabs", "status": "beta" }
      }
    },
    {
      "canonical": "Progress",
      "category": "feedback",
      "sharedProps": {
        "value": "number（0 到 max）",
        "max": "number（默认 100）",
        "size": "sm|md",
        "tone": "primary|success|warning|danger",
        "showLabel": "boolean"
      },
      "eventMap": {
        "web": "无事件（纯展示，Radix value/max 受控）",
        "mini": "无事件（NutUI percent 受控，onActiveEnd 不对外暴露）",
        "native": "无事件（Tamagui value/max 受控）"
      },
      "stacks": {
        "web": { "item": "@kit/web-progress", "status": "beta" },
        "mini": { "item": "@kit/mini-progress", "status": "beta" },
        "native": { "item": "@kit/native-progress", "status": "beta" }
      }
    },
    {
      "canonical": "Skeleton",
      "category": "feedback",
      "sharedProps": {
        "variant": "rect|circle|text",
        "size": "sm|md|lg（circle 直径档）",
        "lines": "number（text 行数，默认 3）",
        "width": "string|number（覆盖）",
        "height": "string|number（覆盖）"
      },
      "eventMap": {
        "web": "无事件（纯占位，aria-hidden）",
        "mini": "无事件（纯占位，CSS 呼吸脉冲）",
        "native": "无事件（纯占位，react-native Animated 呼吸）"
      },
      "stacks": {
        "web": { "item": "@kit/web-skeleton", "status": "beta" },
        "mini": { "item": "@kit/mini-skeleton", "status": "beta" },
        "native": { "item": "@kit/native-skeleton", "status": "beta" }
      }
    },
    {
      "canonical": "Spinner",
      "category": "feedback",
      "sharedProps": {
        "size": "sm|md|lg（直径 16/24/32）",
        "tone": "primary|muted|inverse",
        "accessibilityLabel": "string（无障碍标签，文案外部提供）"
      },
      "eventMap": {
        "web": "无事件（role=status，CSS animate-spin）",
        "mini": "无事件（CSS 1s 匀速旋转）",
        "native": "无事件（react-native Animated.loop 匀速旋转）"
      },
      "stacks": {
        "web": { "item": "@kit/web-spinner", "status": "beta" },
        "mini": { "item": "@kit/mini-spinner", "status": "beta" },
        "native": { "item": "@kit/native-spinner", "status": "beta" }
      }
    },
    {
      "canonical": "Empty",
      "category": "feedback",
      "sharedProps": {
        "title": "ReactNode（主说明）",
        "description": "ReactNode（次要描述，最大宽 280）",
        "icon": "ReactNode slot（替换默认空文档图形）",
        "action": "ReactNode slot（操作区，通常放 Button）",
        "accessibilityLabel": "string（无障碍标签）"
      },
      "eventMap": {
        "web": "无事件（纯组合占位，操作经 action slot 内按钮抛出）",
        "mini": "无事件（纯组合占位，操作经 action slot 内按钮抛出）",
        "native": "无事件（纯组合占位，操作经 action slot 内按钮抛出）"
      },
      "stacks": {
        "web": { "item": "@kit/web-empty", "status": "beta" },
        "mini": { "item": "@kit/mini-empty", "status": "beta" },
        "native": { "item": "@kit/native-empty", "status": "beta" }
      }
    },
    {
      "canonical": "Result",
      "category": "feedback",
      "sharedProps": {
        "status": "'success'|'info'|'warning'|'error'|'notFound'（默认 info，决定默认图标与语义色）",
        "title": "ReactNode（主标题）",
        "description": "ReactNode（次要描述，最大宽 300）",
        "icon": "ReactNode slot（替换默认状态图标）",
        "action": "ReactNode slot（主操作，如重试，可并排多个）",
        "extra": "ReactNode slot（次要操作，如联系客服）",
        "accessibilityLabel": "string（无障碍标签）"
      },
      "eventMap": {
        "web": "无事件（纯组合结果占位，操作经 action/extra slot 内按钮抛出）",
        "mini": "无事件（纯组合结果占位，操作经 action/extra slot 内按钮抛出）",
        "native": "无事件（纯组合结果占位，操作经 action/extra slot 内按钮抛出）"
      },
      "stacks": {
        "web": { "item": "@kit/web-result", "status": "beta" },
        "mini": { "item": "@kit/mini-result", "status": "beta" },
        "native": { "item": "@kit/native-result", "status": "beta" }
      }
    },
    {
      "canonical": "DataTable",
      "category": "data",
      "sharedProps": {
        "columns": "ColumnDef<T>[]",
        "data": "T[]",
        "loading": "boolean",
        "pagination": "PaginationState"
      },
      "eventMap": { "web": "onRowClick", "mini": "onItemClick", "native": "onItemPress" },
      "stacks": {
        "web": { "item": "@kit/web-data-table", "status": "planned" },
        "mini": { "item": "@kit/mini-data-list", "status": "planned" },
        "native": { "item": "@kit/native-data-list", "status": "planned" }
      }
    },
    {
      "canonical": "StateContainer",
      "category": "feedback",
      "sharedProps": {
        "status": "'loading'|'empty'|'error'|'success'（受控，必填，通常由请求 hook 输出）",
        "loadingMode": "'skeleton'|'spinner'（默认 skeleton）",
        "loading": "ReactNode slot（覆盖默认骨架/转圈）",
        "empty": "ReactNode slot（覆盖默认 Empty）",
        "error": "ReactNode slot（覆盖默认 Result error）",
        "onRetry": "() => void（默认错误视图重试回调，传入才显示重试按钮）",
        "children": "ReactNode（success/normal 内容，必填）"
      },
      "eventMap": {
        "web": "onRetry（默认重试按钮 onClick）",
        "mini": "onRetry（默认重试按钮 onPress）",
        "native": "onRetry（默认重试按钮 onPress）"
      },
      "stacks": {
        "web": { "item": "@kit/web-state-container", "status": "beta" },
        "mini": { "item": "@kit/mini-state-container", "status": "beta" },
        "native": { "item": "@kit/native-state-container", "status": "beta" }
      }
    }
  ]
}
