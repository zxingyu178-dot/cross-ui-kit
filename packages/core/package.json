{
  "name": "@kit/core",
  "version": "0.0.1",
  "private": true,
  "description": "三栈共享逻辑内核：请求/表格/表单/状态/校验/工具（headless，不依赖任何渲染环境 API）",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./types/*": "./src/types/*.ts"
  },
  "scripts": {
    "build": "echo \"[core] source-only package, no build step\" && exit 0",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "clsx": "catalog:",
    "dayjs": "catalog:",
    "react": "catalog:",
    "react-hook-form": "catalog:",
    "tailwind-merge": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "happy-dom": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "^3.0.0"
  }
}
