{
  "fontSize": {
    "caption": { "$type": "dimension", "$value": "12px" },
    "body-sm": { "$type": "dimension", "$value": "13px" },
    "body-md": { "$type": "dimension", "$value": "14px" },
    "body-lg": { "$type": "dimension", "$value": "16px" },
    "title-sm": { "$type": "dimension", "$value": "18px" },
    "title-md": { "$type": "dimension", "$value": "20px" },
    "title-lg": { "$type": "dimension", "$value": "24px" },
    "display": { "$type": "dimension", "$value": "30px" }
  },
  "fontWeight": {
    "regular": { "$type": "fontWeight", "$value": 400 },
    "medium": { "$type": "fontWeight", "$value": 500 },
    "semibold": { "$type": "fontWeight", "$value": 600 },
    "bold": { "$type": "fontWeight", "$value": 700 }
  },
  "lineHeight": {
    "tight": { "$type": "number", "$value": 1.25 },
    "normal": { "$type": "number", "$value": 1.5 },
    "relaxed": { "$type": "number", "$value": 1.75 }
  },
  "fontFamily": {
    "sans": {
      "$type": "other",
      "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Helvetica, Arial, sans-serif"
    },
    "mono": {
      "$type": "other",
      "$value": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace"
    }
  }
}
