{
  "name": "play-web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "网页演示壳：验证 @kit/ui-web 组件在真实 Vite 工程可用（只演示，不沉淀通用能力）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@kit/core": "workspace:*",
    "@kit/icons": "workspace:*",
    "@kit/tokens": "workspace:*",
    "@kit/ui-web": "workspace:*",
    "@kit/patterns-web": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:web",
    "@playwright/test": "catalog:web",
    "@storybook/addon-essentials": "catalog:web",
    "@storybook/addon-interactions": "catalog:web",
    "@storybook/blocks": "catalog:web",
    "@storybook/react": "catalog:web",
    "@storybook/react-vite": "catalog:web",
    "@storybook/test": "catalog:web",
    "@tailwindcss/vite": "catalog:web",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:web",
    "axe-core": "catalog:web",
    "storybook": "catalog:web",
    "tailwindcss": "catalog:web",
    "typescript": "catalog:",
    "vite": "catalog:web",
    "vitest": "^3.0.0"
  }
}
