{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@kit/ui-web/*": ["../../packages/ui-web/src/*"],
      "@kit/ui-web": ["../../packages/ui-web/src/index.ts"],
      "@kit/core/*": ["../../packages/core/src/*"],
      "@kit/core": ["../../packages/core/src/index.ts"],
      "@kit/icons": ["../../packages/icons/src/index.ts"],
      "@kit/tokens/*": ["../../packages/tokens/dist/*"]
    }
  },
  "include": ["src"]
}
